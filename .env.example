# Copy this file to .env (already git-ignored) and fill in real values for
# local testing. See pipeline/ODDS_SNAPSHOT_SETUP.md for where each of
# these comes from. Never commit the filled-in .env itself.

ODDS_API_KEY=

# Paste the full service-account JSON key as a single line here, OR leave
# this blank and set GCP_SA_KEY_PATH to a local file path instead (e.g.
# secrets/gcp_service_account.json, also git-ignored).
GCP_SA_KEY_JSON=
GCP_SA_KEY_PATH=

# The target spreadsheet's ID — the long id in its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=
