# data/* (not data/) so the exceptions below actually take effect — a
# directory-matching pattern like "data/" stops git from even looking
# inside it, which silently defeats a per-file "!" negation.
data/*
# models/ contains source code — do not ignore
venv/
__pycache__/
*.pyc
.DS_Store
!docs/data/

# The exceptions to "data/ is always regenerable, never committed":
# - team_games.parquet, coordinators.parquet, win_totals.parquet,
#   schedules.parquet, snap_counts.parquet: small enough (2MB/20KB/8KB/
#   644KB/9MB) and needed pre-populated with full history so CI can
#   refresh just the current season incrementally instead of re-fetching
#   decades of pbp every run. See pipeline/fetch_current_season_data.py.
# - game_lines.parquet, injury_reports.parquet, depth_chart.parquet,
#   madden_ratings.parquet: these accumulate historical data (line movement,
#   injury-report snapshots, weekly depth-chart/ratings snapshots) that
#   otherwise exists nowhere durable in this repo — only in the external
#   sources they come from, which (unlike pbp.parquet) don't offer a
#   historical backfill endpoint, only "current state right now." See
#   pipeline/fetch_game_lines_from_sheet.py, pipeline/build_injury_reports_table.py,
#   pipeline/fetch_depth_chart.py, and pipeline/fetch_madden_ratings.py.
#   madden_ratings.parquet is refreshed manually, not by CI — see that
#   file's docstring for why.
!data/team_games.parquet
!data/coordinators.parquet
!data/win_totals.parquet
!data/schedules.parquet
!data/snap_counts.parquet
!data/game_lines.parquet
!data/injury_reports.parquet
!data/depth_chart.parquet
!data/madden_ratings.parquet
# - week1_baseline_starters.parquet: a one-time-per-season derivation (see
#   pipeline/build_week1_baseline_starters.py) from Week 1 play-by-play,
#   which doesn't change after the fact — not part of the weekly refresh,
#   but still small and worth keeping durable rather than regenerate-only.
!data/week1_baseline_starters.parquet

# Local secrets — see pipeline/ODDS_SNAPSHOT_SETUP.md
.env
secrets/
